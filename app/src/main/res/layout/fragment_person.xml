<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".features.bottom_container.person.PersonFragment">

    <TextView
        android:id="@+id/titleAdminMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Меню Администратора"
        android:textColor="@color/systemColor"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/linkToCountryButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Настройки стран"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/systemColor"
        app:cornerRadius="25dp"
        app:layout_constraintEnd_toEndOf="@+id/titleAdminMenu"
        app:layout_constraintStart_toStartOf="@+id/titleAdminMenu"
        app:layout_constraintTop_toBottomOf="@+id/titleAdminMenu"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/linkToCityButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/systemColor"
        android:text="Настройки городов"
        app:cornerRadius="25dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="@+id/linkToCountryButton"
        app:layout_constraintStart_toStartOf="@+id/linkToCountryButton"
        app:layout_constraintTop_toBottomOf="@+id/linkToCountryButton"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/linkToLeagueButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/systemColor"
        android:text="Настройки лиг"
        app:cornerRadius="25dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="@+id/linkToCityButton"
        app:layout_constraintStart_toStartOf="@+id/linkToCityButton"
        app:layout_constraintTop_toBottomOf="@+id/linkToCityButton"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/linkToPlayerButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/systemColor"
        android:text="Настройки игроков"
        app:cornerRadius="25dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="@+id/linkToLeagueButton"
        app:layout_constraintStart_toStartOf="@+id/linkToLeagueButton"
        app:layout_constraintTop_toBottomOf="@+id/linkToLeagueButton"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/linkToTournamentButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/systemColor"
        android:text="Настройки турниров"
        app:cornerRadius="25dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="@+id/linkToPlayerButton"
        app:layout_constraintStart_toStartOf="@+id/linkToPlayerButton"
        app:layout_constraintTop_toBottomOf="@+id/linkToPlayerButton"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/linkToTeamButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/systemColor"
        android:text="Настройки команд"
        app:cornerRadius="25dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="@+id/linkToTournamentButton"
        app:layout_constraintStart_toStartOf="@+id/linkToTournamentButton"
        app:layout_constraintTop_toBottomOf="@+id/linkToTournamentButton"
        tools:ignore="MissingConstraints" />
</androidx.constraintlayout.widget.ConstraintLayout>