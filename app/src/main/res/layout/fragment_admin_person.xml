<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    android:paddingVertical="16dp"
    tools:context=".features.bottom_container.person.admin_settings.AdminPersonFragment">

    <TextView
        android:id="@+id/titleAdminMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Панель Управления"
        android:textColor="@color/systemColor"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/logoutAdminButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выход"
        android:textAllCaps="false"
        android:backgroundTint="@android:color/holo_red_light"
        app:layout_constraintTop_toTopOf="@id/titleAdminMenu"
        app:layout_constraintBottom_toBottomOf="@id/titleAdminMenu"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Меню Администратора системы"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleAdminMenu" />

    <Space
        android:id="@+id/spacer"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/linkToCountryButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Настройки стран"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/systemColor"
        android:textAlignment="viewStart"
        android:paddingStart="24dp"
        app:iconGravity="start"
        app:iconTint="@android:color/white"
        app:iconPadding="16dp"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spacer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/linkToCityButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Настройки городов"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/systemColor"
        android:textAlignment="viewStart"
        android:paddingStart="24dp"
        app:iconGravity="start"
        app:iconTint="@android:color/white"
        app:iconPadding="16dp"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linkToCountryButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/linkToLeagueButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Настройки турниров"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/systemColor"
        android:textAlignment="viewStart"
        android:paddingStart="24dp"
        app:iconGravity="start"
        app:iconTint="@android:color/white"
        app:iconPadding="16dp"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linkToCityButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/linkToTeamButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Настройки команд"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/systemColor"
        android:textAlignment="viewStart"
        android:paddingStart="24dp"
        app:iconGravity="start"
        app:iconTint="@android:color/white"
        app:iconPadding="16dp"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linkToLeagueButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/linkToPlayerButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:backgroundTint="@color/systemColor"
        android:text="Настройки игроков"
        android:textColor="@android:color/white"
        android:textAlignment="viewStart"
        android:paddingStart="24dp"
        app:iconGravity="start"
        app:iconTint="@android:color/white"
        app:iconPadding="16dp"
        app:cornerRadius="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linkToTeamButton" />

    <TextView
        android:id="@+id/adminUsersTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пользователи"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/linkToPlayerButton"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/adminUsersRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/adminUsersTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_admin_user" />

</androidx.constraintlayout.widget.ConstraintLayout>