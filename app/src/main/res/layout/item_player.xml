<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <ImageView
            android:id="@+id/playerImageView"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Фото игрока"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/playerNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/playerImageView"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Криштиану Роналду" />

        <LinearLayout
            android:id="@+id/linearLayoutNationality"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@+id/playerNameText"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/playerNameText"
            app:layout_constraintTop_toBottomOf="@+id/playerNameText">

            <ImageView
                android:id="@+id/playerCountryFlagView"
                android:layout_width="20dp"  android:layout_height="14dp" android:layout_gravity="center_vertical"
                android:scaleType="centerCrop"
                android:background="#DDDDDD"
                android:contentDescription="Флаг страны игрока" />

            <TextView
                android:id="@+id/playerNationalityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                tools:text="Португалия" />

        </LinearLayout>

        <TextView
            android:id="@+id/playerPositionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#3F51B5"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="@+id/linearLayoutNationality"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/linearLayoutNationality"
            app:layout_constraintTop_toBottomOf="@+id/linearLayoutNationality"
            tools:text="Позиция: Нападающий" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>